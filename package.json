{
  "name": "oracle-broward",
  "version": "0.1.0",
  "private": true,
  "description": "Continuous, incremental Broward County, FL property-intelligence pipeline that builds Elephant Lexicon data groups, derived DuckDB query artifacts and IPFS-ready run manifests.",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "bin": {
    "oracle": "./bin/oracle.mjs"
  },
  "exports": {
    "./client": "./dist/client/index.js",
    "./contract": "./dist/contract/index.js"
  },
  "scripts": {
    "oracle": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.build.json",
    "prepare": "tsc -p tsconfig.build.json || true",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p ui/tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "install:elephant-cli": "bash scripts/install-elephant-cli.sh",
    "fixture": "tsx scripts/make-fixture.ts",
    "ui:dev": "vite --config ui/vite.config.ts",
    "ui:build": "vite build --config ui/vite.config.ts",
    "ui:typecheck": "tsc -p ui/tsconfig.json",
    "serve": "tsx src/cli.ts serve",
    "test:e2e": "playwright test --config ui/playwright.config.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.110",
    "@aws-lambda-powertools/logger": "^2.37.0",
    "@aws-lambda-powertools/metrics": "^2.37.0",
    "@aws-sdk/client-dynamodb": "^3.1179.0",
    "@aws-sdk/client-ssm": "^3.1179.0",
    "@aws-sdk/lib-dynamodb": "^3.1179.0",
    "@duckdb/node-api": "1.5.6-r.2",
    "@fastify/static": "^11.0.0",
    "@huggingface/transformers": "^3.7.6",
    "@ipld/car": "^5.5.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "ai": "^7.0.183",
    "commander": "^14.0.0",
    "fastify": "^5.12.8",
    "multiformats": "^13.4.2",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@duckdb/duckdb-wasm": "^1.33.1-dev57.0",
    "@eslint/js": "^9.30.0",
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.15.0",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "aws-cdk": "^2.1149.0",
    "aws-cdk-lib": "^2.278.0",
    "constructs": "^10.8.1",
    "esbuild": "^0.25.12",
    "eslint": "^9.30.0",
    "maplibre-gl": "^6.20.0",
    "prettier": "^3.6.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.35.0",
    "vite": "^7.3.8",
    "vitest": "^3.2.0"
  }
}
