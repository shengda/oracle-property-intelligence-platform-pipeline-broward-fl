# Publication (M3) — never commit real values
FILEBASE_ACCESS_KEY=
FILEBASE_SECRET_KEY=
FILEBASE_BUCKET=
SECOND_PINNER=
SECOND_PINNER_TOKEN=
# Pinned Elephant CLI 2 binary (scripts/install-elephant-cli.sh)
ELEPHANT_CLI=./bin/elephant-cli
# Agent (M2); local development only — hosted reads SSM Parameter Store
ANTHROPIC_API_KEY=
# default claude-opus-5-5
ORACLE_AGENT_MODEL=
# daily token budget for the whole server (default 3000000) and questions per IP per minute (default 6)
ORACLE_AGENT_DAILY_TOKENS=
ORACLE_AGENT_PER_IP_PER_MINUTE=
# model call timeout in ms (default 90000)
ORACLE_AGENT_TIMEOUT_MS=
